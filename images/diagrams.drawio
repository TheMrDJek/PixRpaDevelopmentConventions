ы идут сверху вниз и к Helpers. Обратных вызовов нет: Infrastructure не вызывает States, Helpers не вызывает Infrastructure.&lt;br&gt;End Process обычно короткий: оставьте его контейнером в main.pix, без отдельного скрипта и try/catch. Папку States/EndProcess заводите, если завершение сложное." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#23446F;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="470" width="600" height="64" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="558" width="30" height="16" as="geometry"/></mxCell><mxCell id="c32" value="main.pix" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="51" y="556" width="66" height="20" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="170" y="558" width="30" height="16" as="geometry"/></mxCell><mxCell id="c34" value="бизнес-логика" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="206" y="556" width="101" height="20" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="558" width="30" height="16" as="geometry"/></mxCell><mxCell id="c36" value="адаптер" style="text;strokeColor=non