ационные тесты адаптеров на DEV;&lt;br&gt;сквозные тесты робота идут на UAT и в проекте не хранятся&lt;/font&gt;" style="rounded=0;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=12;dashed=1;dashPattern=6 4;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="586" width="440" height="50" as="geometry"/></mxCell><mxCell id="c23" value="Infrastructure" style="rounded=0;dashed=1;dashPattern=4 4;fillColor=#FFFFFF;strokeColor=#B3B3B3;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#666666;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="40" width="180" height="596" as="geometry"/></mxCell><mxCell id="c24" value="Адаптеры вызывают любые состояния и сценарии." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#23446F;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="62" width="165" height="34" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;PixMaster&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GetQueueItem,&lt;br&gt;AddResponseItem&lt;/font&gt;" style="rounded=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="502" y="110" width="156" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;PIX Master&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;очереди, ассеты&lt;/font&gt;" style="rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="712" y="110" width="146" height="60" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;