="26" as="geometry"/></mxCell><mxCell id="c3" value="ДВА РОБОТА: ОДИН СТЫК" style="rounded=0;fillColor=#FAFAFA;strokeColor=#999999;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#555555;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10" y="44" width="860" height="300" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Почта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;акты сверки, PDF или скан&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="25" y="84" width="130" height="56" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;кладет каждый акт в очередь&lt;/font&gt;" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="84" width="170" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Acts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;элемент = акт&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B85450&quot;&gt;&lt;b&gt;стык 1&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontColor=#000000;fontSize=12;direction=south;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="77" width="120" height="70" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="Очередь Finance.ReconcileActs.Acts. В конце квартала акты приходят сотнями: Performer запускают на нескольких агентах, и они разбирают одну очередь." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#23446F;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="80" width="300" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Performer&lt;/b&gt;: каждый агент ведет свой акт через все шаги" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="25" y="180" width="830" height="150" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;Распознать акт&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;документы и сальдо из PDF&lt;/font&gt;" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="120" height="62" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Найти контрагента&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;в 1С по ИНН&lt;/font&gt;" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="175" y="214" width="120" height="62" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;Выгрузить из 1С&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;документы за период&lt;/font&gt;" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="214" width="120" height="62" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Сравнить&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;дата, сумма, сальдо&lt;/font&gt;" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="445" y="214" width="120" height="62" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Сформировать протокол&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;разногласий&lt;/font&gt;" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="214" width="120" height="62" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Загрузить в 1С&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;протокол к контрагенту&lt;/font&gt;" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="715" y="214" width="120" height="62" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Каждый шаг лежит в своем скрипте. Выполненные шаги отмечаются в элементе очереди: после сбоя повтор продолжает с последнего шага, и акт заново не распознается и не выгружается из 1С." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#23446F;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="800" height="40" as="geometry"/></mxCell><mxCell id="c24" value="ЧЕТЫРЕ РОБОТА: ТРИ СТЫКА" style="rounded=0;fillColor=#FAFAFA;strokeColor=#999999;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#555555;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10" y="364" width="860" height="320" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Почта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;акты сверки, PDF или скан&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="25" y="404" width="130" height="56" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;кладет акт в очередь&lt;/font&gt;" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="180" y="404" width="150" height="56" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;ToRecognize&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;элемент = акт&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B85450&quot;&gt;&lt;b&gt;стык 1&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontColor=#000000;fontSize=12;direction=south;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="397" width="120" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Распознавание&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;шаг 1&lt;/font&gt;" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="515" y="404" width="160" height="56" as="geometry"/></mxCell><mxCell id="c29" value="Медленный этап запускают на нескольких агентах, остальные на одном." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#23446F;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="695" y="404" width="160" height="56" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;ToExport&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;элемент = акт&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B85450&quot;&gt;&lt;b&gt;стык 2&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontColor=#000000;fontSize=12;direction=south;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="520" width="120" height="70" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Выгрузка из 1С&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;шаги 2 и 3: контрагент, документы&lt;/font&gt;" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="180" y="527" width="165" height="56" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;ToCompare&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;элемент = акт&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B85450&quot;&gt;&lt;b&gt;стык 3&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontColor=#000000;fontSize=12;direction=south;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="375" y="520" width="120" height="70" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Сравнение и загрузка в 1С&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;шаги 4–6: сравнить, протокол, загрузить&lt;/font&gt;" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="530" y="527" width="185" height="56" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;1С&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;данные контрагента&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="745" y="527" width="110" height="56" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="496"/><mxPoint x="85" y="496"/></Array></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="262" y="608"/><mxPoint x="800" y="608"/></Array></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=classic;endFill=1;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="Очереди Finance.ReconcileActs.ToRecognize, .ToExport и .ToCompare. На каждом стыке нужна защита от потери и дублей. Выгрузка и загрузка в 1С работают с данными одного контрагента, но лежат в разных роботах: правка формата затронет оба, а при ручном перезапуске акт возвращают в одну из трех очередей." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#23446F;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="620" width="830" height="56" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="702" width="30" height="16" as="geometry"/></mxCell><mxCell id="c46" value="робот" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="51" y="700" width="45" height="20" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="702" width="30" height="16" as="geometry"/></mxCell><mxCell id="c48" value="шаг в скрипте робота" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="156" y="700" width="150" height="20" as="geometry"/></mxCell><mxCell id="c49" value="" style="rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="702" width="30" height="16" as="geometry"/></mxCell><mxCell id="c50" value="очередь PIX Master" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="700" width="136" height="20" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="500" y="702" width="30" height="16" as="geometry"/></mxCell><mxCell id="c52" value="внешняя система" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="536" y="700" width="115" height="20" as="geometry"/></mxCell><mxCell id="c53" value="стык" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="15" y="726" width="40" height="20" as="geometry"/></mxCell><mxCell id="c54" value="передача между роботами: нужна защита от потери и дублей" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize